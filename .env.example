# Record-mode credentials. Copy to .env and fill in real values. .env is
# gitignored; never commit real keys. Your client SDK reads these standard
# provider env vars to set the request's auth header. In --record mode llmock
# forwards that header to the real upstream; llmock itself never reads these vars.

# Anthropic (x-api-key forwarded upstream)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (x-goog-api-key forwarded upstream)
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Azure OpenAI: point --upstream-openai at the endpoint and forward the api-key.
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
